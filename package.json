{
	"name": "n8n-nodes-darkmoon",
	"version": "0.1.0",
	"description": "n8n community node to trigger a Darkmoon AI pentest and retrieve its findings",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"darkmoon",
		"pentest",
		"security",
		"appsec",
		"dast",
		"vulnerability"
	],
	"license": "MIT",
	"homepage": "https://github.com/ASCIT31/n8n-nodes-darkmoon",
	"author": {
		"name": "ASC-IT / Darkmoon"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ASCIT31/n8n-nodes-darkmoon.git"
	},
	"engines": {
		"node": ">=20.15"
	},
	"main": "index.js",
	"scripts": {
		"build": "npx rimraf dist && tsc && gulp build:icons",
		"dev": "tsc --watch",
		"format": "prettier nodes credentials --write",
		"lint": "eslint nodes credentials package.json",
		"lintfix": "eslint nodes credentials package.json --fix",
		"test:e2e": "node test/e2e.mjs"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/DarkmoonApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Darkmoon/Darkmoon.node.js"
		]
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"devDependencies": {
		"@types/node": "^20.19.43",
		"@typescript-eslint/parser": "^7.15.0",
		"eslint": "^8.57.0",
		"eslint-plugin-n8n-nodes-base": "^1.16.3",
		"gulp": "^5.0.0",
		"n8n-workflow": "*",
		"prettier": "^3.3.2",
		"rimraf": "^5.0.7",
		"typescript": "^5.5.3"
	}
}
